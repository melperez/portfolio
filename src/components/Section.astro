---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="section-shell scroll-mt-24 py-16 sm:py-20">
  <div class="mb-9 flex items-center gap-4">
    <span class="section-index text-xs font-semibold tracking-[0.18em] text-accent uppercase">{String(['experience','projects','ask','skills','contact'].indexOf(id) + 1).padStart(2, '0')}</span>
    <h2 id={`${id}-title`} class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
    <span class="section-rule h-px flex-1 bg-line"></span>
  </div>
  <slot />
</section>
