---
import { getProfile } from '../lib/content';
import { ui, type Locale } from '../i18n';
interface Props { locale?: Locale }
const locale = Astro.props.locale ?? 'en';
const t = ui[locale];
const profile = await getProfile();
---

<p class="max-w-2xl font-serif text-2xl leading-snug sm:text-3xl">
  {t.contact}
</p>
<a href={`mailto:${profile.email}`} class="mt-7 inline-flex text-lg font-semibold text-accent underline decoration-accent/30 underline-offset-8 hover:decoration-accent">{profile.email} <span class="ml-2">↗</span></a>
<ul class="mt-7 flex flex-wrap gap-5 text-sm">
  {
    profile.links.map((l) => (
      <li>
        <a href={l.url} class="underline underline-offset-4 hover:text-accent" rel="me noopener">
          {l.label}
        </a>
      </li>
    ))
  }
  <li>
    <a href={profile.cvPdf} class="underline underline-offset-4 hover:text-accent" download>CV (PDF)</a>
  </li>
</ul>
